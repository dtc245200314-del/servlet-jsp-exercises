<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><h2>${action eq 'delete' ? 'Xác nhận xóa user' : 'Chi tiết user'}</h2><dl><dt>ID</dt><dd>${user.id}</dd><dt>Name</dt><dd><c:out value="${user.name}"/></dd><dt>Email</dt><dd><c:out value="${user.email}"/></dd><dt>Country</dt><dd><c:out value="${user.country}"/></dd></dl><c:if test="${action eq 'delete'}"><p>Thao tác sẽ xóa user và các quyền đã gán. Bạn có chắc muốn xóa?</p><form action="users" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="mode" value="${mode}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${user.id}"><button class="danger">Xác nhận xóa</button></form></c:if><%@ include file="footer.jspf" %>
