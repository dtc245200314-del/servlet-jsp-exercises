<%@ page pageEncoding="UTF-8" %>
<%@ include file="header.jspf" %><h2>${empty user ? 'Thêm user' : 'Sửa user'}</h2><form action="users" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="mode" value="${mode}"><input type="hidden" name="action" value="${empty user ? 'create' : 'update'}"><c:if test="${not empty user}"><input type="hidden" name="id" value="${user.id}"></c:if><label>Name <input name="name" maxlength="50" value="<c:out value='${user.name}'/>" required></label><label>Email <input name="email" type="email" maxlength="100" value="<c:out value='${user.email}'/>" required></label><label>Country <input name="country" maxlength="50" value="<c:out value='${user.country}'/>" required></label><c:if test="${empty user}"><fieldset><legend>Quyền khi thêm bằng Transaction (525)</legend><label><input type="checkbox" name="permissions" value="1"> add</label><label><input type="checkbox" name="permissions" value="2"> edit</label><label><input type="checkbox" name="permissions" value="3"> delete</label><label><input type="checkbox" name="permissions" value="4"> view</label></fieldset></c:if><button name="creation" value="standard">Lưu bằng ${mode}</button><c:if test="${empty user}"><button name="creation" value="transaction">Lưu user và quyền bằng Transaction</button></c:if></form><%@ include file="footer.jspf" %>
