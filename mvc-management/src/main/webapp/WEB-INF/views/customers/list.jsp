<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Quản lý khách hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><header><a href="${pageContext.request.contextPath}/customers">Khách hàng</a><a href="${pageContext.request.contextPath}/products">Sản phẩm</a></header><main><h1>Quản lý khách hàng</h1><form method="get"><label for="q">Tìm theo tên</label><input id="q" name="q" value="<c:out value='${param.q}'/>"><button>Tìm kiếm</button><a href="${kind}?action=new">Thêm mới</a></form><table><thead><tr><th>ID</th><th>Họ tên</th><th>Email</th><th>Địa chỉ</th><th>Thao tác</th></tr></thead><tbody><c:forEach var="item" items="${items}"><tr><td>${item.id}</td><td><c:out value="${item.name}"/></td><td><c:out value="${item.email}"/></td><td><c:out value="${item.address}"/></td><td><a href="?action=view&amp;id=${item.id}">Xem</a> <a href="?action=edit&amp;id=${item.id}">Sửa</a> <a href="?action=delete&amp;id=${item.id}">Xóa</a></td></tr></c:forEach></tbody></table><c:if test="${empty items}"><p>Không có kết quả phù hợp.</p></c:if></main></body></html>
