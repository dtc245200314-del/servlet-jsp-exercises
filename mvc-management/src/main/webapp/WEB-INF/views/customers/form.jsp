<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin khách hàng</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><header><a href="${pageContext.request.contextPath}/customers">Khách hàng</a><a href="${pageContext.request.contextPath}/products">Sản phẩm</a></header><main><h1>Thông tin khách hàng</h1><form method="post" action="${kind}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="${empty item ? 'create' : 'update'}"><input type="hidden" name="id" value="${item.id}"><label for="name">Họ tên</label><input id="name" name="name" type="text" maxlength="100" value="<c:out value='${item.name}'/>" required><label for="email">Email</label><input id="email" name="email" type="email" maxlength="100" value="<c:out value='${item.email}'/>" required><label for="address">Địa chỉ</label><input id="address" name="address" type="text" maxlength="255" value="<c:out value='${item.address}'/>" required><button type="submit">Lưu thông tin</button> <a href="${kind}">Hủy</a></form></main></body></html>
