<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Thông tin sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><header><a href="${pageContext.request.contextPath}/customers">Khách hàng</a><a href="${pageContext.request.contextPath}/products">Sản phẩm</a></header><main><h1>Thông tin sản phẩm</h1><form method="post" action="${kind}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="${empty item ? 'create' : 'update'}"><input type="hidden" name="id" value="${item.id}"><label for="name">Tên sản phẩm</label><input id="name" name="name" type="text" maxlength="100" value="<c:out value='${item.name}'/>" required><label for="price">Giá</label><input id="price" name="price" type="number" min="0" max="999999999.99" step="0.01" value="<c:out value='${item.price}'/>" required><label for="description">Mô tả</label><textarea id="description" name="description" maxlength="2000" required><c:out value="${item.description}"/></textarea><label for="manufacturer">Nhà sản xuất</label><input id="manufacturer" name="manufacturer" type="text" maxlength="100" value="<c:out value='${item.manufacturer}'/>" required><button type="submit">Lưu thông tin</button> <a href="${kind}">Hủy</a></form></main></body></html>
