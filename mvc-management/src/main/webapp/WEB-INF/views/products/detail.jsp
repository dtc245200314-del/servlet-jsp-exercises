<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Chi tiết sản phẩm</title><link rel="stylesheet" href="${pageContext.request.contextPath}/style.css"></head><body><header><a href="${pageContext.request.contextPath}/customers">Khách hàng</a><a href="${pageContext.request.contextPath}/products">Sản phẩm</a></header><main><h1>Chi tiết sản phẩm</h1><dl><dt>ID</dt><dd>${item.id}</dd><dt>Tên sản phẩm</dt><dd><c:out value="${item.name}"/></dd><dt>Giá</dt><dd><c:out value="${item.price}"/></dd><dt>Mô tả</dt><dd><c:out value="${item.description}"/></dd><dt>Nhà sản xuất</dt><dd><c:out value="${item.manufacturer}"/></dd></dl><c:if test="${action == 'delete'}"><p>Bạn có chắc muốn xóa bản ghi này?</p><form method="post" action="${kind}"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${item.id}"><button type="submit">Xác nhận xóa</button></form></c:if><a href="${kind}">Về danh sách</a></main></body></html>
