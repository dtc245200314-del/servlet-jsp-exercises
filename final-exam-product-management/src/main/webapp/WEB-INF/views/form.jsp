<%@ page pageEncoding="UTF-8" %><%@ include file="header.jspf" %><a class="back-link" href="products">← Danh sách sản phẩm</a><div class="page-heading"><div><p class="eyebrow">THÔNG TIN SẢN PHẨM</p><h1>${editing ? 'Sửa sản phẩm' : 'Thêm sản phẩm'}</h1><p class="muted">Nhập đầy đủ ba trường bên dưới để lưu sản phẩm.</p></div></div><section class="panel form-panel"><c:if test="${not empty error}"><p class="error" role="alert"><c:out value="${error}"/></p></c:if><form action="products" method="post"><input type="hidden" name="csrf" value="${sessionScope.csrf}"><input type="hidden" name="action" value="${editing ? 'update' : 'create'}"><c:if test="${editing}"><input type="hidden" name="id" value="${productId}"></c:if><label for="name">Tên sản phẩm <span aria-hidden="true">*</span></label><input id="name" name="name" maxlength="255" value="<c:out value='${form.name}'/>" placeholder="Ví dụ: Bàn phím cơ" required autofocus><div class="form-grid"><div><label for="price">Giá (VNĐ) <span aria-hidden="true">*</span></label><input id="price" name="price" type="number" min="0" max="9999999999999.99" step="0.01" value="<c:out value='${form.price}'/>" placeholder="0.00" required><small>Không âm, tối đa 2 chữ số thập phân.</small></div><div><label for="quantity">Số lượng <span aria-hidden="true">*</span></label><input id="quantity" name="quantity" type="number" min="0" max="2147483647" step="1" value="<c:out value='${form.quantity}'/>" placeholder="0" required><small>Số nguyên không âm.</small></div></div><div class="form-actions"><button type="submit">${editing ? 'Lưu thay đổi' : 'Thêm sản phẩm'}</button><a class="button secondary" href="products">Hủy</a></div></form></section><%@ include file="footer.jspf" %>
