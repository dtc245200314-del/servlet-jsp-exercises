<%@ page pageEncoding="UTF-8" %><%@ include file="header.jspf" %><div class="page-heading"><div><p class="eyebrow">KHO SẢN PHẨM</p><h1>Danh sách sản phẩm</h1><p class="muted">Quản lý tên, giá và số lượng trong cơ sở dữ liệu.</p></div><a class="button" href="products?action=new">+ Thêm sản phẩm</a></div><c:if test="${not empty notice}"><div class="notice" role="status"><c:out value="${notice}"/></div></c:if><section class="panel"><div class="table-scroll"><table><caption class="visually-hidden">Danh sách tất cả sản phẩm trong cơ sở dữ liệu</caption><thead><tr><th scope="col">ID</th><th scope="col">Tên sản phẩm</th><th scope="col" class="number">Giá (VNĐ)</th><th scope="col" class="number">Số lượng</th><th scope="col">Thao tác</th></tr></thead><tbody><c:forEach var="p" items="${products}"><tr><td class="muted">#<c:out value="${p.id}"/></td><td class="product-name"><c:out value="${p.name}"/></td><td class="number"><c:out value="${p.price}"/></td><td class="number"><span class="quantity"><c:out value="${p.quantity}"/></span></td><td class="actions"><a href="products?action=edit&amp;id=${p.id}">Sửa</a><a class="delete-link" href="products?action=delete&amp;id=${p.id}">Xóa</a></td></tr></c:forEach><c:if test="${empty products}"><tr><td colspan="5" class="empty-state">Chưa có sản phẩm. Hãy thêm sản phẩm đầu tiên.</td></tr></c:if></tbody></table></div></section><p class="hint">Chọn “Sửa” để cập nhật thông tin hoặc “Xóa” để mở bước xác nhận.</p><%@ include file="footer.jspf" %>
