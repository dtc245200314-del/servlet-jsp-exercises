<%@ page contentType="text/html;charset=UTF-8" import="com.codegym.practice.Calculations,com.codegym.practice.Html,java.math.BigDecimal" %>
<% request.setCharacterEncoding("UTF-8"); String result; try { BigDecimal rate=Calculations.nonNegative(request.getParameter("rate")); BigDecimal usd=Calculations.nonNegative(request.getParameter("usd")); BigDecimal vnd=usd.multiply(rate); result=vnd.toPlainString()+" VNĐ"; } catch(IllegalArgumentException ex){ response.setStatus(400); result=ex.getMessage(); } %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kết quả JSP</title><link rel="stylesheet" href="style.css"></head><body><main><h1>Kết quả chuyển đổi JSP</h1><p class="result"><%= Html.escape(result) %></p><a href="jsp-currency.jsp">Chuyển đổi tiếp</a></main></body></html>
