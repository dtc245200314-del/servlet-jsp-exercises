<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Calculator</title><link rel="stylesheet" href="style.css"></head><body><main><h1>Calculator</h1><form action="calculator" method="post"><label for="left">Toán hạng thứ nhất</label><input id="left" name="left" type="number" step="any" value="<c:out value='${param.left}'/>" required><label for="operator">Phép toán</label><select id="operator" name="operator"><option value="+">Cộng (+)</option><option value="-">Trừ (-)</option><option value="*">Nhân (*)</option><option value="/">Chia (/)</option></select><label for="right">Toán hạng thứ hai</label><input id="right" name="right" type="number" step="any" value="<c:out value='${param.right}'/>" required><button>Tính</button></form><c:if test="${not empty result}"><p class="result">Kết quả: <c:out value="${result}"/></p></c:if><c:if test="${not empty error}"><p class="error" role="alert"><c:out value="${error}"/></p></c:if><p><a href="index.jsp">Trang bài tập</a></p></main></body></html>
