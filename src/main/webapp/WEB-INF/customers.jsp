<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Danh sách khách hàng</title><link rel="stylesheet" href="style.css"></head><body><main><h1>Danh sách khách hàng</h1><p>Dữ liệu giả lập phục vụ bài tập.</p><div class="table-scroll"><table><thead><tr><th>Tên</th><th>Ngày sinh</th><th>Địa chỉ</th><th>Ảnh</th></tr></thead><tbody><c:forEach var="customer" items="${customers}"><tr><td><c:out value="${customer.name}"/></td><td><c:out value="${customer.birthday}"/></td><td><c:out value="${customer.address}"/></td><td><img class="avatar" src="<c:out value='${customer.image}'/>" alt="Ảnh đại diện minh họa"></td></tr></c:forEach></tbody></table></div><p><a href="index.jsp">Trang bài tập</a></p></main></body></html>
