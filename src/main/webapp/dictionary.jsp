<%@ page contentType="text/html;charset=UTF-8" import="java.util.Map,java.util.Locale,com.codegym.practice.Html" %>
<% request.setCharacterEncoding("UTF-8"); Map<String,String> words=Map.of("hello","Xin chào","book","Quyển sách","computer","Máy tính","student","Sinh viên","how","Thế nào"); String search=request.getParameter("search"); String meaning=search==null?null:words.get(search.trim().toLowerCase(Locale.ROOT)); %>
<!doctype html><html lang="vi"><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Kết quả từ điển JSP</title><link rel="stylesheet" href="style.css"></head><body><main><h1>Từ điển JSP</h1><p>Từ khóa: <%= Html.escape(search) %></p><p class="result"><%= Html.escape(meaning==null?"Không tìm thấy từ.":meaning) %></p><a href="jsp-dictionary.jsp">Tra tiếp</a></main></body></html>
